# -------------------------------------------------------------------
# Build artifacts & compiled objects (ignore contents, allow binary)
# -------------------------------------------------------------------
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.ptx
*.cubin
*.fatbin
*.nvlog
build/*
lib/
bin/
obj/
.deps/

# -------------------------------------------------------------------
# Commercial source code protection – keep these private
# -------------------------------------------------------------------
*.cu
bls12_381_common.h

# -------------------------------------------------------------------
# Explicitly ALLOW the public API header and the compiled binary
# -------------------------------------------------------------------
!zk_bls_pub.h
!build/libzk_bls_accel.so

# -------------------------------------------------------------------
# CUDA / NVCC intermediate files
# -------------------------------------------------------------------
*.cu.o
*.cu.d
*.cu.ptx
*.cu.cubin
*.cu.fatbin
*.cu.*.reg
*.cu.*.sm
*.cu.*.nvcc*

# -------------------------------------------------------------------
# Python cache & virtual environments
# -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv*
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
*.log

# -------------------------------------------------------------------
# IDE & editor files
# -------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.vs/

# -------------------------------------------------------------------
# LaTeX auxiliary files (keep only final PDF)
# -------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.brf
*.idx
*.ilg
*.ind
*.synctex.gz
*.fls
*.fdb_latexmk
*_minted*
epaper/*.pdf

# Keep the final manuscript PDF
!epaper/main.pdf

# -------------------------------------------------------------------
# Benchmark outputs & large data files
# -------------------------------------------------------------------
*.dat
*.npy
*.npz
*.hdf5
*.pkl
*.json
*.csv
*.prof
*.nsys-rep
*.sqlite
benchmarks/*.log
benchmarks/*.txt

# EXCEPTION: Keep our generated empirical scaling data
!benchmarks/scaling_manifest.txt

# -------------------------------------------------------------------
# Temporary files
# -------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.patch
core
*.core
